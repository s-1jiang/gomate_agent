APP_NAME=GoMate
DATABASE_PATH=data/gomate.db
TOKEN_TTL_SECONDS=86400
# Persistent browser login defaults to 30 days. Enable secure cookies behind HTTPS.
REMEMBER_TOKEN_TTL_SECONDS=2592000
AUTH_COOKIE_SECURE=false
# Docker Compose always uses queue mode. Native development defaults to inline.
# Generate a local broker password; no RabbitMQ port is published to the host.
RABBITMQ_PASSWORD=replace-with-a-random-local-password
WORKER_CONCURRENCY=2
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
RUN_TIMEOUT_SECONDS=240
MAX_ACTIVE_RUNS_PER_USER=2
MAX_TOOL_CALLS_PER_RUN=32
MAX_EXTERNAL_REQUESTS_PER_RUN=48
MAX_LLM_CALLS_PER_RUN=16
TOOL_TIMEOUT_SECONDS=10
MAX_PARALLEL_TOOLS_PER_RUN=4

# DeepSeek: never commit a real key. Model identifiers remain configurable.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_THINKING=disabled
LLM_TIMEOUT_SECONDS=30
CHAT_HISTORY_MESSAGES=20
CHAT_HISTORY_CHARS=40000
CHAT_MAX_OUTPUT_TOKENS=4096

# AMap city/keyword search. Browser map display uses a separate JS key and server-side proxy.
MAP_PROVIDER=amap
MAP_TIMEOUT_SECONDS=10
AMAP_MIN_INTERVAL_SECONDS=1.1
MAX_REVIEW_ROUNDS=2
AMAP_WEB_SERVICE_KEY=
DEFAULT_CITY=
# Browser JS API key is separate; configure its domain restrictions in AMap console.
AMAP_JS_API_KEY=
# Keep the JS security secret on the server, behind the SDK's fixed security proxy.
AMAP_JS_SECURITY_CODE=

# Optional web evidence for itinerary activities, opening and reservation notes.
# Get a key from https://app.tavily.com/ and recreate backend after updating .env.
TAVILY_API_KEY=
WEB_SEARCH_TIMEOUT_SECONDS=12

# Docker Compose frontend entry point. Backend is reachable only inside the container network.
GOMATE_WEB_PORT=8080
